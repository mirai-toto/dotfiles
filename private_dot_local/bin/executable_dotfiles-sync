#!/bin/bash
# Run the existing save/apply scripts in each installed dotfiles repo.

set -euo pipefail

usage() {
  echo "Usage: dotfiles-sync {save|apply}"
}

public_repo_path() {
  local config="$HOME/.config/chezmoi/chezmoi.toml"
  local repo
  if [ ! -f "$config" ]; then
    echo "Install public dotfiles before running dotfiles-sync." >&2
    return 1
  fi

  repo=$(sed -n 's/^[[:space:]]*sourceDir[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$config" | head -n 1)
  if [ -z "$repo" ] || [ ! -d "$repo" ]; then
    echo "Public dotfiles sourceDir is missing or invalid in $config." >&2
    return 1
  fi
  echo "$repo"
}

registered_repo_path() {
  local registration=$1 action=$2
  local profile=${registration##*/}
  local repo
  if [ ! -L "$registration" ] || [ ! -d "$registration" ]; then
    echo "Invalid private profile registration: $registration" >&2
    return 1
  fi
  repo=$(realpath "$registration")
  if [ ! -f "$repo/profile-id" ] ||
    [ "$(cat "$repo/profile-id")" != "$profile" ] || [ ! -f "$repo/$action.sh" ]; then
    echo "Invalid private profile registration: $registration" >&2
    return 1
  fi
  echo "$repo"
}

run_action() {
  local repo=$1 action=$2 public_repo=$3
  if [ "$action" = save ]; then
    bash "$repo/save.sh"
  elif [ "$repo" = "$public_repo" ]; then
    bash "$repo/apply.sh" --no-brew
  else
    bash "$repo/apply.sh"
  fi
}

main() {
  local action registration repo public_repo
  local -a repos
  case "${1:-}" in
  save | apply) action=$1 ;;
  -h | --help) usage; return 0 ;;
  *) usage >&2; return 2 ;;
  esac
  if [ "$#" -ne 1 ]; then
    usage >&2
    return 2
  fi

  # The public repo uses chezmoi; private installers register their checkout symlinks.
  public_repo=$(public_repo_path)
  repos=("$public_repo")
  for registration in "$HOME"/.config/dotfiles/profiles.d/*; do
    [ -e "$registration" ] || [ -L "$registration" ] || continue
    repo=$(registered_repo_path "$registration" "$action")
    repos+=("$repo")
  done

  for repo in "${repos[@]}"; do
    run_action "$repo" "$action" "$public_repo"
  done
}

main "$@"
