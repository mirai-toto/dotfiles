#!/bin/bash
# Run the existing save/apply scripts in each installed dotfiles repo.

set -euo pipefail

case "${1:-}" in
save | apply) action=$1 ;;
-h | --help) echo "Usage: dotfiles-sync {save|apply}"; exit 0 ;;
*) echo "Usage: dotfiles-sync {save|apply}" >&2; exit 2 ;;
esac

if [ "$#" -ne 1 ]; then
  echo "Usage: dotfiles-sync {save|apply}" >&2
  exit 2
fi

# The public repo is recorded by install.sh; the private repos create these shortcuts on apply.
config="$HOME/.config/chezmoi/chezmoi.toml"
if [ ! -f "$config" ] || [ ! -d "$HOME/memos/personal" ]; then
  echo "Install public and personal dotfiles before running dotfiles-sync." >&2
  exit 1
fi

public_repo=$(sed -n 's/^[[:space:]]*sourceDir[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$config" | head -n 1)
if [ -z "$public_repo" ] || [ ! -d "$public_repo" ]; then
  echo "Public dotfiles sourceDir is missing or invalid in $config." >&2
  exit 1
fi

repos=("$public_repo" "$(dirname "$(realpath "$HOME/memos/personal")")")
if [ -L "$HOME/memos/private" ]; then
  if [ ! -d "$HOME/memos/private" ]; then
    echo "Work dotfiles shortcut is broken: $HOME/memos/private" >&2
    exit 1
  fi
  repos+=("$(dirname "$(realpath "$HOME/memos/private")")")
fi

for repo in "${repos[@]}"; do
  if [ "$action" = save ]; then
    bash "$repo/save.sh"
  else
    if [ "$repo" = "$public_repo" ]; then
      bash "$repo/apply.sh" --no-brew
    else
      bash "$repo/apply.sh"
    fi
  fi
done
