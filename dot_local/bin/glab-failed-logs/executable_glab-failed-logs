#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: glf [--wait] [--repo PROJECT] [PIPELINE_ID]

Show the trace for every failed job in a GitLab pipeline. Without a pipeline
ID, inspect the latest pipeline for the current branch. Use --wait to wait for
that pipeline to finish before showing failed job traces.
EOF
}

repo_args=()
repo_target=''
pipeline_id=''
wait_for_pipeline=false
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -R|--repo)
      [[ "$#" -ge 2 ]] || { usage >&2; exit 2; }
      repo_args+=(--repo "$2")
      repo_target="$2"
      shift 2
      ;;
    --repo=*)
      repo_args+=(--repo "${1#*=}")
      repo_target="${1#*=}"
      shift
      ;;
    -w|--wait)
      wait_for_pipeline=true
      shift
      ;;
    --)
      shift
      [[ "$#" -le 1 ]] || { usage >&2; exit 2; }
      pipeline_id="${1:-}"
      break
      ;;
    -* )
      usage >&2
      exit 2
      ;;
    *)
      [[ -z "$pipeline_id" ]] || { usage >&2; exit 2; }
      pipeline_id="$1"
      shift
      ;;
  esac
done

command -v glab >/dev/null || { printf 'error: glab is required\n' >&2; exit 1; }
command -v jq >/dev/null || { printf 'error: jq is required\n' >&2; exit 1; }

if [[ "$wait_for_pipeline" == true ]]; then
  [[ -z "$pipeline_id" ]] || { printf 'error: --wait cannot be used with PIPELINE_ID\n' >&2; exit 2; }
  glab ci status --wait "${repo_args[@]}" >/dev/null
fi

pipeline_args=(--output json --with-job-details "${repo_args[@]}")
if [[ -n "$pipeline_id" ]]; then
  pipeline_args+=(--pipeline-id "$pipeline_id")
fi

pipeline_json="$(glab ci get "${pipeline_args[@]}")"
pipeline_id="$(jq -r '.id' <<<"$pipeline_json")"
[[ -n "$pipeline_id" && "$pipeline_id" != null ]] || { printf 'error: could not determine pipeline ID\n' >&2; exit 1; }

declare -A seen_pipelines=()
failed_job_count=0

show_pipeline_logs() {
  local current_id="$1"
  local current_repo="$2"
  local current_json="${3:-}"
  local -a current_repo_args=()
  local -a api_repo_args=()
  local failed_jobs downstream_pipelines
  local job_id job_name downstream_id downstream_url downstream_repo key

  key="${current_repo:-.}:$current_id"
  [[ -z "${seen_pipelines[$key]:-}" ]] || return 0
  seen_pipelines[$key]=1

  if [[ -n "$current_repo" ]]; then
    current_repo_args=(--repo "$current_repo")
    api_repo_args=(--repo "$current_repo")
  fi

  if [[ -z "$current_json" ]]; then
    current_json="$(glab ci get --output json --with-job-details --pipeline-id "$current_id" "${current_repo_args[@]}")"
  fi

  printf 'Pipeline %s (%s, %s)\n' "$current_id" "$(jq -r '.status' <<<"$current_json")" "$(jq -r '.ref // "current branch"' <<<"$current_json")"

  failed_jobs="$(jq -r '.jobs[]? | select(.status == "failed") | [.id, .name] | @tsv' <<<"$current_json")"
  if [[ -n "$failed_jobs" ]]; then
    while IFS=$'\t' read -r job_id job_name; do
      printf '\n===== %s (%s) =====\n' "$job_name" "$job_id"
      glab ci trace "$job_id" --pipeline-id "$current_id" "${current_repo_args[@]}"
      ((failed_job_count += 1))
    done <<<"$failed_jobs"
  fi

  # Trigger/bridge jobs are exposed separately from regular jobs by GitLab.
  # Follow their downstream pipelines so failures in child pipelines are shown too.
  downstream_pipelines="$(glab api "projects/:fullpath/pipelines/$current_id/bridges" --paginate "${api_repo_args[@]}" | jq -r '.[]? | .downstream_pipeline // empty | [.id, (.web_url // "")] | @tsv')"
  while IFS=$'\t' read -r downstream_id downstream_url; do
    [[ -n "$downstream_id" ]] || continue
    downstream_repo="$current_repo"
    if [[ "$downstream_url" == http://* || "$downstream_url" == https://* ]]; then
      downstream_repo="${downstream_url%%/-/pipelines/*}"
    fi
    show_pipeline_logs "$downstream_id" "$downstream_repo"
  done <<<"$downstream_pipelines"
}

show_pipeline_logs "$pipeline_id" "$repo_target" "$pipeline_json"
if (( failed_job_count == 0 )); then
  printf 'No failed jobs.\n'
fi
